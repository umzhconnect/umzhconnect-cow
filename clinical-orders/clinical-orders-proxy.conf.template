# =============================================================================
# clinical-orders FHIR proxy — outward, partition-less endpoint in front of the
# partitioned base HAPI. SHARED by docker compose AND Kubernetes: this file is
# mounted at /etc/nginx/templates/default.conf.template and rendered at container
# start by the official nginx image's built-in envsubst. Only ${PROXY_*} are
# substituted (NGINX_ENVSUBST_FILTER=PROXY_); nginx's own $host / $1 survive.
#
#   inbound   /fhir/…            → /fhir/clinical-orders/…   (on ${PROXY_UPSTREAM})
#   outbound  the partition segment is stripped from self-links (sub_filter) and
#             the Location header (proxy_redirect); Content-Location is dropped —
#             so the partition never appears in an outward URL.
#
# Host values (${PROXY_UPSTREAM}, ${PROXY_OUTWARD_URL}, ${PROXY_INTERNAL_BASE})
# come from the environment (.env for compose; Deployment env for k8s).
# PROXY_INTERNAL_BASE is the base URL HAPI advertises in self-links (its
# server_address / FHIR_SERVER_ADDRESS), defaulting to the sentinel
# http://localhost:8090/fhir; the rewrites below key off it, so it MUST match
# whatever HAPI actually emits. The partition name is structural and stays
# literal here.
# =============================================================================
upstream hapi_base { server ${PROXY_UPSTREAM}; }

server {
    listen 8080;

    proxy_buffering         on;
    proxy_buffer_size       128k;
    proxy_buffers           16 128k;
    proxy_busy_buffers_size 256k;

    location ~ ^/fhir(/.*)?$ {
        # /fhir(/...)  ->  /fhir/clinical-orders(/...)  on the base.
        rewrite ^/fhir(/.*)?$ /fhir/clinical-orders$1 break;
        proxy_pass        http://hapi_base;
        proxy_set_header  Host            $host;
        proxy_set_header  X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header  Accept-Encoding "";

        sub_filter_once  off;
        sub_filter_types *;
        # HAPI builds self-links from its server_address (${PROXY_INTERNAL_BASE})
        # + partition; rewrite that host+partition to the partition-less outward
        # base URL. The second rule strips the partition from any remaining
        # relative occurrence.
        sub_filter "${PROXY_INTERNAL_BASE}/clinical-orders/" "${PROXY_OUTWARD_URL}/fhir/";
        sub_filter "/fhir/clinical-orders/" "/fhir/";

        # sub_filter only touches the body — also fix the Location header on
        # create/update, and drop the duplicate (leaking) Content-Location.
        proxy_redirect    "${PROXY_INTERNAL_BASE}/clinical-orders/" "${PROXY_OUTWARD_URL}/fhir/";
        proxy_hide_header Content-Location;
    }
}
