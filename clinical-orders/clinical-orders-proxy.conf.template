# =============================================================================
# clinical-orders FHIR proxy — outward, partition-less endpoint in front of the
# partitioned base HAPI. SHARED by docker compose AND Kubernetes: mounted at
# /etc/nginx/templates/default.conf.template and rendered by the nginx image's
# envsubst. Only ${PROXY_*} are substituted (NGINX_ENVSUBST_FILTER=PROXY_);
# nginx's own $host / $1 / $fwd_* survive.
#
#   inbound   /fhir/…  →  ${PROXY_BACKEND_PATH}/…  on the backend
#   outbound  the partition segment is stripped from bodies (sub_filter) and the
#             Location header (proxy_redirect) — the partition never appears outward.
#
# URL RENDERING — the backend renders absolute self-links PER REQUEST from the
# X-Forwarded-Host / X-Forwarded-Proto this proxy forwards (HAPI's
# ApacheProxyAddressStrategy; server_address left blank). So one store can back
# MULTIPLE outward hosts, and this proxy no longer rewrites the host — it only
# strips the partition path, host-agnostically. (If a backend can't derive its base
# from forwarded headers, give it a fixed base and add a host-rewriting sub_filter.)
#
# BACKEND (env):
#   ${PROXY_UPSTREAM}       backend host:port
#   ${PROXY_SCHEME}         http | https (default http; https ⇒ TLS to the backend)
#   ${PROXY_BACKEND_HOST}   Host header + TLS SNI to present (default nginx $host)
#   ${PROXY_BACKEND_PATH}   backend path prefix (default /fhir/clinical-orders;
#                           set to /fhir for a NON-partitioned backend)
#   ${PROXY_BACKEND_AUTHORIZATION}  optional full Authorization header injected
#                           upstream (e.g. "Basic <b64>"); empty forwards the
#                           caller's own Authorization unchanged.
# =============================================================================

# Optional backend auth: empty ⇒ forward the caller's Authorization unchanged.
map $backend_authorization $fhir_authorization {
    ""      $http_authorization;
    default $backend_authorization;
}
# Preserve the ORIGINAL forwarded host/proto through a proxy chain (ingress →
# gateway → here); fall back to what this hop sees (single-hop / compose).
map $http_x_forwarded_host  $fwd_host  { ""  $http_host; default $http_x_forwarded_host; }
map $http_x_forwarded_proto $fwd_proto { ""  $scheme; default $http_x_forwarded_proto; }

upstream hapi_base { server ${PROXY_UPSTREAM}; }

server {
    listen 8080;

    proxy_buffering         on;
    proxy_buffer_size       128k;
    proxy_buffers           16 128k;
    proxy_busy_buffers_size 256k;

    location ~ ^/fhir(/.*)?$ {
        # Bake the optional backend-auth value BEFORE `rewrite … break` (the break
        # halts rewrite-module directives, `set` included).
        set               $backend_authorization "${PROXY_BACKEND_AUTHORIZATION}";

        # /fhir(/...)  ->  ${PROXY_BACKEND_PATH}(/...) on the backend.
        rewrite ^/fhir(/.*)?$ ${PROXY_BACKEND_PATH}$1 break;
        proxy_pass        ${PROXY_SCHEME}://hapi_base;
        proxy_set_header  Host              ${PROXY_BACKEND_HOST};
        # The backend renders self-links from these — forward the OUTWARD host/proto.
        proxy_set_header  X-Forwarded-Host  $fwd_host;
        proxy_set_header  X-Forwarded-Proto $fwd_proto;
        proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header  Accept-Encoding   "";
        proxy_set_header  Authorization     $fhir_authorization;

        # TLS to an external backend — ignored when ${PROXY_SCHEME} is http. For a
        # real external server also enable `proxy_ssl_verify on;` + a trusted CA.
        proxy_ssl_server_name on;
        proxy_ssl_name        ${PROXY_BACKEND_HOST};

        # Strip the partition from responses (host-agnostic — the backend already
        # emits the correct outward host). Two rules cover  /partition/…  AND
        # /partition?query  (paging links), so the partition never leaks.
        sub_filter_once  off;
        sub_filter_types *;
        sub_filter "${PROXY_BACKEND_PATH}/" "/fhir/";
        sub_filter "${PROXY_BACKEND_PATH}?" "/fhir?";

        # Location header (create/update) — strip the partition on any host.
        proxy_redirect ~*^(https?://[^/]+)${PROXY_BACKEND_PATH}/(.*)$ $1/fhir/$2;
        proxy_hide_header Content-Location;
    }
}
