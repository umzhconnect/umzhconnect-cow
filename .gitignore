# ── umzhconnect-cow ──────────────────────────────────────────────────────────
# Local deployment config (copy from .env.example)
.env
# macOS folder metadata
.DS_Store
# Key / cert material — NEVER commit a private key. These globs have no leading
# slash, so they match anywhere in the repo (e.g. a private.pem outside keys/).
# Only sealed artifacts (*-sealedsecret.yaml) belong in git.
*.key
*.pem
# L2 public JWK Set — generated by keys/gen-keys.sh; kept out of git too. The
# scripts (*.sh) and README stay tracked.
keys/*.jwks.json

# ── Python bytecode (key-custodian) ─────────────────────────────────────────
__pycache__/
*.pyc

# ── tests ───────────────────────────────────────────────────────────────────
tests/reports/*.xml
