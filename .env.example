# =============================================================================
# umzhconnect-cow — single-party ecosystem node configuration
# =============================================================================
# Copy to `.env` and fill in the values for YOUR party. This node runs as one
# party in a UMZH Connect ecosystem; the auth server is external and reached at
# the URL below. The mCSD registry and the partner node are also external, but
# not configured here — callers reach them directly, out-of-band.
#
# Replace the 'your-party' placeholders with your party's identity (as registered
# in the ecosystem's auth server) and point the URLs at your ecosystem. The URL
# defaults target a locally-running ecosystem (host.docker.internal / localhost
# ports — e.g. the reference two-party sandbox) so you can try the node out
# before wiring in real infrastructure.

# ── This party's identity ────────────────────────────────────────────────────
# Your party's short identifier — used for container/network names and as this
# node's label in the ecosystem. Set it to your party's id.
PARTY=your-party
# This party's L2 (private_key_jwt) client, pre-registered in the auth server
# with its jwks.url pointing at OWN_EXTERNAL_URL/jwks.json (see README).
# Generate the key referenced by L2_KID before `docker compose up`:
#   keys/gen-keys.sh l2      (writes keys/l2.{key,jwks.json}, with kid=l2)
L2_CLIENT_ID=your-party-client-l2
L2_KID=l2

# ── Ecosystem-shared services (NOT deployed here — fetched from here) ─────────
# Auth server (Keycloak or any OIDC provider that issues the ecosystem tokens).
# AUTH_SERVER_URL    = where this node reaches it (backchannel: token POST, JWKS).
# AUTH_SERVER_PUBLIC_URL = the issuer/audience the auth server advertises; the
#   client assertion's `aud` must equal this. In a normal deployment the auth
#   server has one public URL, so set both equal. They differ here only because
#   the sandbox Keycloak advertises localhost:8180 but is reached via
#   host.docker.internal:8180 from inside this node's containers.
AUTH_SERVER_URL=http://host.docker.internal:8180
AUTH_SERVER_PUBLIC_URL=http://localhost:8180
AUTH_SERVER_REALM=umzh-connect

# ── This party's own public URLs ──────────────────────────────────────────────
# OWN_EXTERNAL_URL MUST equal the host:port the partner (and the auth server's
# jwks.url for this client) use to reach this node's external gateway.
OWN_EXTERNAL_URL=http://localhost:9081

# Upstream (host:port) the external gateway proxies /jwks.json to — this party's
# key custodian, which serves the L2 JWK Set. On the compose network that is the
# key-custodian service; in k8s set JWKS_UPSTREAM in the apisix-gateway-config
# ConfigMap to the custodian's cluster address.
JWKS_UPSTREAM=key-custodian:8000

# ── Host port mappings for this node's containers ────────────────────────────
EXTERNAL_GATEWAY_PORT=9081
HAPI_PORT=9090
OPA_PORT=9181
KEY_CUSTODIAN_PORT=9087

# ── clinical-orders FHIR proxy (mirrors the k8s clinical-orders proxy) ────────
# Outward, partition-less FHIR endpoint in front of the base FHIR store — the
# local partitioned base HAPI by default, or an external server fronted
# directly. The proxy renders the SHARED clinical-orders/ proxy template via
# the nginx image (PROXY_UPSTREAM = base host:port; PROXY_OUTWARD_URL =
# CLINICAL_ORDERS_FHIR_URL). The *_URL is what the proxy advertises in
# rewritten self-links; keep it equal to the host:port the proxy is reachable
# on.
HAPI_BASE_UPSTREAM=hapi-fhir:8080
# Scheme the proxy uses to CONNECT to HAPI_BASE_UPSTREAM — http for the local
# base HAPI (default); https for an external server that requires TLS.
PROXY_UPSTREAM_SCHEME=http
# Request path prefix on HAPI_BASE_UPSTREAM — the local base HAPI's partition
# by default. Set to an external server's own base path (e.g. /UMZHCONNECT) to
# front that instead — see clinical-orders-proxy.conf.template.
PROXY_UPSTREAM_PATH=/fhir/clinical-orders
CLINICAL_ORDERS_FHIR_PORT=9091
CLINICAL_ORDERS_FHIR_URL=http://localhost:9091
# The backend's own advertised base URL, in full — exactly what a resource's
# self-link/fullUrl starts with (partition included, if any). The proxy
# rewrites this to its outward URL, so it MUST match whatever the backend
# actually emits. Leave the sentinel default when HAPI is fronted only by this
# proxy (compose does not override FHIR_SERVER_ADDRESS); set it to the base
# HAPI's real advertised base + partition (== FHIR_SERVER_ADDRESS +
# /clinical-orders) when the base is ALSO exposed directly (e.g. via
# hapi-fhir-ingress in k8s), or to the external server's own base URL when
# fronting one of those.
PROXY_INTERNAL_BASE=http://localhost:8090/fhir/clinical-orders
# OPTIONAL, clinical-orders proxy ONLY (not the registry). Full Authorization
# header the clinical-orders proxy injects toward the backend FHIR store when set
# — e.g. "Basic <base64(user:pass)>". Leave EMPTY to disable: the caller's own
# Authorization is forwarded unchanged and nothing is intercepted. Treat a real
# value as a secret (keep it in your local .env only; in k8s use a Secret).
PROXY_BACKEND_AUTHORIZATION=
# OPTIONAL: full Authorization header OPA sends to the FHIR server on its OWN
# Consent/Task/ServiceRequest fetches (OPA queries the base HAPI directly, not via
# the proxy). Same format as above — "Basic <base64(user:pass)>". Empty = no
# header (default). Read via opa.runtime().env in opa/policies/apisix.rego; a
# secret (keep it in your local .env only; in k8s inject from a Secret).
FHIR_BACKEND_AUTHORIZATION=

# ── Managed (external) Postgres — NOT deployed here ──────────────────────────
# HAPI FHIR connects to a managed database service. The defaults point
# at a local Postgres on the host (reached from containers via
# host.docker.internal) with a pre-created 'hapi_fhir' database owned by
# 'umzhconnect'. Consumed by hapi-fhir/application.yaml (DB_* placeholders).
#
# NOTE: a container connecting over host.docker.internal appears to Postgres as a
# TCP client from the Docker bridge — the host's pg_hba.conf must permit
# password (md5/scram) logins for that subnet, otherwise the connection is
# rejected.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=hapi_fhir
DB_USERNAME=umzhconnect
DB_PASSWORD=umzhconnect
