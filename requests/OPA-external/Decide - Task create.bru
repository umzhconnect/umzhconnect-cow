meta {
  name: Decide - Task create
  type: http
  seq: 2
}

post {
  url: {{opaUrl}}/v1/data/umzh/authz/gateway/allow
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": {
      "request": {
        "method": "POST",
        "path": "/fhir/Task",
        "query": {},
        "headers": {
          "authorization": "Bearer {{bearerToken}}"
        },
        "body": "{\"resourceType\":\"Task\",\"requester\":{\"reference\":\"{{orgRef}}\"}}"
      }
    }
  }
}

docs {
  May this caller create a Task (POST /fhir/Task)? Allows when the token carries
  system/Task.c (or system/Task.crus), and the body, sent as a raw string, names
  the token's org as requester and has no output or businessStatus. Response:
  { "result": true|false }.
}
