meta {
  name: 2 Exchange for token
  type: http
  seq: 2
}

post {
  url: {{kcUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{clientId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{assertion}}
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}

docs {
  Step 2: exchange the signed assertion for an M2M access token
  (client_credentials). The token is saved to `accessToken` and carries this
  party's SMART scopes and organization_reference claim. Run "1 Sign assertion"
  first.
}
