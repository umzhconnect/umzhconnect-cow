meta {
  name: Create Task
  type: http
  seq: 2
}

post {
  url: {{gatewayUrl}}/fhir/Task
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Task",
    "status": "requested",
    "intent": "order",
    "requester": { "reference": "{{orgRef}}" },
    "owner": { "reference": "{{orgRef}}" }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("taskId", res.body.id);
  }
}

docs {
  Create a Task (OPA Rule 1c: system/Task.c scope). requester/owner are set to
  this party's own org (orgRef) so the later List and Patch requests match. The
  new id is saved to {{taskId}}.
}
