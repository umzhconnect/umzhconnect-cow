meta {
  name: Rule 1c - Task create
  type: http
  seq: 3
}

post {
  url: {{opaUrl}}/v1/data/umzh/authz/allow
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": {
      "method": "POST",
      "path": "/fhir/Task",
      "body": {
        "resourceType": "Task",
        "requester": { "reference": "{{orgA}}" }
      },
      "organization_reference": "{{orgA}}",
      "scope": "system/Task.c",
      "context": ""
    }
  }
}

docs {
  Rule 1c — Task create (POST). Requires system/Task.c, Task.requester ==
  organization_reference and no Task.output or businessStatus. No HAPI fetch.
  Expect { "result": true }.
}
