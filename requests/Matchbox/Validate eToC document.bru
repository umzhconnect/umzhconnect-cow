script:pre-request {
  // Validate the output of "Transform to eToC" when it ran before in this
  // session; otherwise fall back to the sample document in the body above.
  const doc = bru.getVar("etocDocument");
  if (doc) {
    req.setBody(JSON.parse(doc));
    console.log("Validating the transform result (etocDocument)");
  } else {
    console.log("No etocDocument var — validating the sample body");
  }
}

tests {
  test("returns an OperationOutcome", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().resourceType).to.equal("OperationOutcome");
  });
  
  test("no error or fatal issues against ch-etoc-document", function() {
    const issues = res.getBody().issue || [];
    const errors = issues
      .filter(i => i.severity === "error" || i.severity === "fatal")
      .map(i => `${(i.expression || i.location || ["-"])[0]}: ${i.diagnostics}`);
    expect(errors, errors.join("\n")).to.be.empty;
  });
}

docs {
  Validates a CH eToC document Bundle against ch-etoc-document (ch-etoc 3.0.1)
  via matchbox $validate. Body = the "Transform to eToC" result when that ran
  first (runtime var etocDocument, see pre-request script); otherwise the
  sample matchbox/sample/Sample_eToC_PetraMeier_edited.json pasted above.
  Expect 0 errors; the remaining warnings (dom-6 narrative, codes not checkable
  without a terminology server) are benign.
  Requires matchbox WITH the ch-etoc IG loaded: the k8s deployment loads it
  (matchbox/ig-validation.yaml); the default compose matchbox is transform-only
  (see BACKLOG.md), where the profile is unknown and the call fails. The first
  call after a (re)start builds the validation engine and can take minutes.
}
