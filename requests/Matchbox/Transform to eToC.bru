script:post-response {
  // Hand the eToC document to "Validate eToC document" (runs next in the folder).
  if (res.getStatus() === 200) {
    bru.setVar("etocDocument", JSON.stringify(res.getBody()));
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a CH eToC document Bundle led by a Composition", function() {
    const body = res.getBody();
    expect(body.resourceType).to.equal("Bundle");
    expect(body.type).to.equal("document");
    expect(body.entry[0].resource.resourceType).to.equal("Composition");
  });
}

docs {
  Runs the CH eToC StructureMap over the placer's ServiceRequest search Bundle
  (the exact getServiceRequest response shape, incl. the requester's
  Practitioner via _include:iterate=PractitionerRole:practitioner) and returns a
  CH eToC document Bundle. The map must be loaded first: on k8s the
  matchbox-load-maps Job does that after deploy; locally run
  matchbox/test-transform.sh once. Otherwise you get 422 "Map not available".
  Canonical: http://umzhconnect.ch/fhir/StructureMap/ServiceRequestBundleToChEtoc
  The result is stored in the runtime var etocDocument, which
  "Validate eToC document" then validates — run the Matchbox folder in order.
}
